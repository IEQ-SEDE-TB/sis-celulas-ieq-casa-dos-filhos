# Configuração do Supabase
# 1. Acesse https://app.supabase.com -> seu projeto -> Project Settings -> API
# 2. Copie os valores e cole abaixo (sem aspas)

# Project URL (Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# anon / public key (Settings > API > Project API keys > anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key (Settings > API > Project API keys > service_role)
# NUNCA exponha esta chave no client. Use apenas em Server Actions / Route Handlers.
# SUPABASE_SERVICE_ROLE_KEY=
